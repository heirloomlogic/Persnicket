{
  "problemMatcher": [
    {
      "owner": "swift-format",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+): (warning|error): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "swift-format-config",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^<unknown>: (warning|error): (.+)$",
          "severity": 1,
          "message": 2
        }
      ]
    }
  ]
}
